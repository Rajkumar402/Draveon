# API Provider: groq or openrouter
API_PROVIDER=openrouter
LLM_MODEL=google/gemma-2-9b-it:free

# Never commit credentials. Revoke and rotate any key ever committed before use.
API_KEY_1=
API_KEY_2=
API_KEY_3=
API_KEY_4=
API_KEY_5=
API_KEY_6=

# Local development only. Production must use managed secrets, HTTPS origins,
# a managed database, migrations, and a reverse proxy that keeps FastAPI private.
APP_ENV=development
DATABASE_URL=sqlite:///./backend/draveon.db
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/api
ALLOW_PUBLIC_SIGNUP=true
# APP_ENV=production
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# DATABASE_URL=postgresql+psycopg://app_user:password@db-host/draveon
# AUTO_CREATE_SCHEMA=false
